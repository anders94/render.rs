##RenderMan RIB-Structure 1.1
# Phase 10 demo gate, part 2: subsurface scattering. An abstract marble
# "bust" (displaced subdivision blob on a pedestal) and a skin-tone twin,
# strongly backlit so light bleeds through the thin edges — the SSS
# money shot.
version 3.04
Display "bust.exr" "file" "rgb"
Format 1280 640 1.0
Projection "perspective" "fov" [28]
PixelFilter "gaussian" 2 2
Rotate -6 1 0 0
Translate 0 -2.1 0

WorldBegin
    Light "PxrDomeLight" "sky" "intensity" [0.35] "lightColorMap" ["sky.hdr"]
    # Strong warm key behind and above the busts (the bleed light).
    TransformBegin
        Translate 0 6.5 16.5
        Rotate 145 1 0 0
        Scale 2.2 2.2 1
        Light "PxrRectLight" "key" "intensity" [55] "lightColor" [1 0.82 0.6]
    TransformEnd

    Bxdf "PxrSurface" "floor"
        "diffuseColor" [0.16 0.16 0.18] "specularIor" [1.5] "specularRoughness" [0.12]
    Polygon "P" [-60 0 -5  60 0 -5  60 0 120  -60 0 120]

    # --- Left: marble ----------------------------------------------------
    AttributeBegin
        Bxdf "PxrSurface" "marble"
            "diffuseGain" [0]
            "subsurfaceGain" [1]
            "subsurfaceColor" [0.83 0.79 0.75]
            "subsurfaceDmfp" [0.55 0.5 0.42]
            "specularIor" [1.49] "specularRoughness" [0.07]
        ShadingRate 0.25
        Translate -1.55 1.5 12
        Rotate 24 0 1 0
        Displace "noise" "amplitude" [0.16] "frequency" [1.1] "octaves" [4] "gain" [0.5]
        SubdivisionMesh "catmull-clark"
            [4 4 4 4 4 4]
            [0 1 2 3  5 4 7 6  4 0 3 7  1 5 6 2  3 2 6 7  4 5 1 0]
            "P" [-0.62 -1.05 -0.5  0.62 -1.05 -0.5  0.72 1.0 -0.42  -0.72 1.0 -0.42
                 -0.62 -1.05 0.5  0.62 -1.05 0.5  0.72 1.0 0.42  -0.72 1.0 0.42]
    AttributeEnd
    AttributeBegin
        Bxdf "PxrSurface" "pedestal"
            "diffuseColor" [0.22 0.21 0.2] "specularIor" [1.4] "specularRoughness" [0.4]
        Translate -1.55 0 12
        Rotate -90 1 0 0
        Cylinder 0.55 0 0.58 360
        Disk 0.58 0.55 360
    AttributeEnd

    # --- Right: skin tone ------------------------------------------------
    AttributeBegin
        Bxdf "PxrSurface" "skin"
            "diffuseGain" [0]
            "subsurfaceGain" [1]
            "subsurfaceColor" [0.78 0.48 0.34]
            "subsurfaceDmfp" [0.32 0.17 0.09]
            "specularIor" [1.44] "specularRoughness" [0.32]
        ShadingRate 0.25
        Translate 1.55 1.5 12
        Rotate -18 0 1 0
        Displace "noise" "amplitude" [0.16] "frequency" [1.1] "octaves" [4] "gain" [0.5] "offset" [7 3 1]
        SubdivisionMesh "catmull-clark"
            [4 4 4 4 4 4]
            [0 1 2 3  5 4 7 6  4 0 3 7  1 5 6 2  3 2 6 7  4 5 1 0]
            "P" [-0.62 -1.05 -0.5  0.62 -1.05 -0.5  0.72 1.0 -0.42  -0.72 1.0 -0.42
                 -0.62 -1.05 0.5  0.62 -1.05 0.5  0.72 1.0 0.42  -0.72 1.0 0.42]
    AttributeEnd
    AttributeBegin
        Bxdf "PxrSurface" "pedestal2"
            "diffuseColor" [0.22 0.21 0.2] "specularIor" [1.4] "specularRoughness" [0.4]
        Translate 1.55 0 12
        Rotate -90 1 0 0
        Cylinder 0.55 0 0.58 360
        Disk 0.58 0.55 360
    AttributeEnd
WorldEnd
