Display "showcase.ppm" "file" "rgb"
Format 1024 768 1.0
Projection "perspective" "fov" [55]

WorldBegin
    # Floor - large flat cylinder
    TransformBegin
        Color 0.3 0.3 0.3
        Surface "matte"
        Translate 0 -3 12
        Scale 15 1 15
        Cylinder 0.5 -0.05 0.05 360
    TransformEnd

    # Back wall
    TransformBegin
        Color 0.4 0.4 0.5
        Surface "matte"
        Translate 0 0 18
        Scale 20 10 1
        Cylinder 0.5 -0.1 0.1 360
    TransformEnd

    # Red sphere - matte
    TransformBegin
        Color 0.9 0.1 0.1
        Surface "matte"
        Translate -4 -1 10
        Sphere 1.2 -1.2 1.2 360
    TransformEnd

    # Green cylinder - plastic
    TransformBegin
        Color 0.1 0.9 0.1
        Surface "plastic"
        Translate -1.5 -1 10
        Cylinder 0.8 -1.8 1.8 360
    TransformEnd

    # Blue cone - plastic
    TransformBegin
        Color 0.1 0.1 0.9
        Surface "plastic"
        Translate 1.5 -1 10
        Rotate -90 1 0 0
        Cone 3 1.2 360
    TransformEnd

    # Yellow sphere - metal (reflective)
    TransformBegin
        Color 1 1 0.2
        Surface "metal"
        Translate 4 -1 10
        Sphere 1.2 -1.2 1.2 360
    TransformEnd

    # Purple sphere - high up
    TransformBegin
        Color 0.8 0.2 0.8
        Surface "plastic"
        Translate 0 2 9
        Sphere 0.9 -0.9 0.9 360
    TransformEnd

    # Orange cylinder - rotated
    TransformBegin
        Color 1 0.5 0
        Surface "plastic"
        Translate -3 1 8
        Rotate 30 0 0 1
        Rotate 20 1 0 0
        Cylinder 0.5 -1.5 1.5 360
    TransformEnd

    # Cyan cone - small
    TransformBegin
        Color 0 0.9 0.9
        Surface "matte"
        Translate 3 0.5 8
        Rotate -90 1 0 0
        Scale 0.8 0.8 0.8
        Cone 2 0.7 360
    TransformEnd
WorldEnd
