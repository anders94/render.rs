##RenderMan RIB-Structure 1.1
Display "output.ppm" "file" "rgb"
Format 640 480 1.0
PixelSamples 2 2
Projection "perspective" "fov" [45]

WorldBegin
    # Lighting
    LightSource "distantlight" 1 "from" [5 10 -10] "to" [0 0 0] "intensity" [0.8]
    LightSource "pointlight" 2 "from" [5 5 -5] "intensity" [0.5]

    # Blue sphere (left)
    AttributeBegin
        Color 0 0 1
        Surface "plastic"
        Translate -2 0 5
        Sphere 1 -1 1 360
    AttributeEnd

    # Green cone (center)
    AttributeBegin
        Color 0 1 0
        Surface "plastic"
        Translate 0 0 5
        Rotate -90 1 0 0
        Cone 2 0.8 360
    AttributeEnd

    # Red cylinder (right)
    AttributeBegin
        Color 1 0 0
        Surface "matte"
        Translate 2 0 5
        Cylinder 0.5 -1 1 360
    AttributeEnd

    # Yellow furball (bottom - matte sphere)
    AttributeBegin
        Color 1 1 0
        Surface "matte"
        Translate 0 -2 5
        Sphere 0.7 -0.7 0.7 360
    AttributeEnd
WorldEnd
