##RenderMan RIB-Structure 1.1
# Phase 10 demo gate, part 1: a cloudscape at sunset. Heterogeneous fBm
# media in invisible hulls, delta/ratio tracking, HG forward scattering
# (silver linings), and a hazy atmosphere for aerial perspective.
version 3.04
Display "clouds.exr" "file" "rgb"
Format 1280 640 1.0
Projection "perspective" "fov" [38]
PixelFilter "gaussian" 2 2
Rotate 4 1 0 0
Translate 0 -2.5 0

# Thin evening haze: aerial perspective + sun shafts.
Atmosphere "haze" "sigma_a" [0.00012 0.00015 0.0002] "sigma_s" [0.0005 0.0006 0.00075] "g" [0.35] "maxdistance" [900]

WorldBegin
    # Dusk dome (constant deep blue) + low orange sun.
    Light "PxrDomeLight" "dusk" "intensity" [0.28] "lightColor" [0.3 0.38 0.62]
    # Sun just above the horizon, behind the clouds: light travels along
    # the frame's -z, so a small +x rotation tilts it downward at us.
    TransformBegin
        Rotate -12 1 0 0
        Light "PxrDistantLight" "sun" "intensity" [5.0] "lightColor" [1.0 0.5 0.2]
            "angleExtent" [1.5]
    TransformEnd

    # The sea.
    Bxdf "PxrSurface" "sea"
        "diffuseGain" [0.25] "diffuseColor" [0.02 0.05 0.08]
        "specularIor" [1.33] "specularRoughness" [0.06]
    Polygon "P" [-3000 0 -50  3000 0 -50  3000 0 4000  -3000 0 4000]

    # --- The cloud bank: hull spheres, squashed and layered -------------
    Bxdf "PxrSurface" "hull" "diffuseGain" [0] "specularIor" [1]

    AttributeBegin
        Interior "cumulus" "sigma_a" [0.04 0.045 0.055] "sigma_s" [11 11 11] "g" [0.62]
            "density" ["fbm"] "frequency" [0.085] "octaves" [5] "gain" [0.58]
            "coverage" [0.56] "sharpness" [3.2]
        TransformBegin Translate -34 26 150 Scale 30 11 22 Sphere 1 -1 1 360 TransformEnd
        TransformBegin Translate 18 21 120 Scale 24 8.5 18 Sphere 1 -1 1 360 TransformEnd
        TransformBegin Translate 55 30 190 Scale 34 12 26 Sphere 1 -1 1 360 TransformEnd
        TransformBegin Translate -70 33 230 Scale 40 13 30 Sphere 1 -1 1 360 TransformEnd
        TransformBegin Translate 2 38 260 Scale 46 14 34 Sphere 1 -1 1 360 TransformEnd
        TransformBegin Translate -12 16 95 Scale 14 5.5 11 Sphere 1 -1 1 360 TransformEnd
        TransformBegin Translate 38 14 85 Scale 10 4 8 Sphere 1 -1 1 360 TransformEnd
    AttributeEnd

    # High thin layer, wispier.
    AttributeBegin
        Interior "cirrus" "sigma_a" [0.01 0.01 0.012] "sigma_s" [2.2 2.2 2.2] "g" [0.5]
            "density" ["fbm"] "frequency" [0.05] "octaves" [4] "gain" [0.6]
            "coverage" [0.42] "sharpness" [2.0]
        TransformBegin Translate -20 55 330 Scale 90 6 50 Sphere 1 -1 1 360 TransformEnd
        TransformBegin Translate 70 62 380 Scale 70 5 45 Sphere 1 -1 1 360 TransformEnd
    AttributeEnd
WorldEnd
